---
// src/layouts/Layout.astro
import "../styles/global.css";
export interface Props {
  title: string;
}
const { title } = Astro.props;

/*
   ── La vista previa al compartir el link ──────────────────────
   La imagen va en 1200x630, que es la franja que usa WhatsApp. Si se
   pone la portada tal cual —que es vertical— WhatsApp le corta arriba y
   abajo y se ve un pedazo del medio; por eso miniatura-whatsapp.jpg
   ya viene en esa medida con todo el dibujo adentro.

   La ruta se arma con Astro.site (la dirección del config): WhatsApp no
   sigue rutas relativas, necesita la dirección completa.

   No va og:description a propósito: sin ella WhatsApp muestra la imagen
   grande y solo el nombre debajo, que es lo que se busca. Con
   descripción agrega un párrafo de texto que ensucia la tarjeta.
*/
const miniatura = new URL('/imagenes/miniatura-whatsapp.jpg', Astro.site).href;
const paginaActual = new URL(Astro.url.pathname, Astro.site).href;
/*
   Al compartir el link se quiere SOLO la imagen, sin texto. WhatsApp
   siempre pone un título y, si falta og:title, usa el <title> de la
   pestaña. Por eso el título de la vista previa es un carácter en blanco
   (U+2800): la tarjeta queda con la imagen sola. La pestaña del navegador
   sigue con su título normal.
*/
const tituloPreview = '⠀';
const textoImagen = 'Sophia, invitación especial a su cumpleaños';
---

<!doctype html>
<html lang="es" class="m-0 p-0">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="only light" />
    <!-- Manzana roja en la pestaña del navegador -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- ── Vista previa al compartir el link ─────────────────── -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={tituloPreview} />
    <meta property="og:url" content={paginaActual} />
    <meta property="og:image" content={miniatura} />
    <meta property="og:image:secure_url" content={miniatura} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={textoImagen} />
    <meta property="og:locale" content="es_ES" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloPreview} />
    <meta name="twitter:image" content={miniatura} />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Un solo pedido: Great Vibes + Cormorant Garamond en los grosores
         que usan los componentes (400 a 700, normal y cursiva) -->
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Great+Vibes&display=swap"
      rel="stylesheet"
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      /* Forzar modo claro y evitar dark mode del navegador */
      html {
        width: 100%;
        height: 100%;
        overflow-x: hidden;
        color-scheme: only light;
      }

      body {
        margin: 0;
        padding: 0;
        width: 100%;
        min-height: 100vh;
        overflow-x: hidden;
        color-scheme: only light;
        /* Fuera de la columna móvil (tablet / PC) */
        background-color: #e9e4dd;
      }

      /* La invitación SIEMPRE se ve como celular: columna centrada */
      main {
        width: 100%;
        max-width: 430px;
        margin: 0 auto;
        min-height: 100vh;
        /*
           Blanco de base; encima va el fondo principal (main::before).

           El blanco va declarado como imagen y no como color: el modo
           oscuro forzado de algunos celulares oscurece los colores pero
           respeta las imágenes, así que escrito así la hoja no se vuelve
           gris ni negra.
        */
        background-image: linear-gradient(#ffffff, #ffffff);
        background-repeat: no-repeat;
        background-attachment: fixed;
        background-size: cover;
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.08);
        position: relative;
        isolation: isolate;
      }

      /*
         Fondo principal (bosque) detrás de todas las secciones. Va en una
         capa fija y no con background-attachment: fixed, porque en iPhone
         eso no funciona y la imagen se estira al alto de toda la página.
      */
      /*
         Las secciones no llevan fondo propio: así el fondo principal se ve
         en todas. Una sola regla acá en vez de tocar cada componente; para
         devolverle el fondo a una sección, basta con sacarla de esta regla.
      */
      main .seccion {
        background: none !important;
      }

      main::before {
        content: "";
        position: fixed;
        top: 0;
        bottom: 0;
        left: 50%;
        width: 100%;
        max-width: 430px;
        transform: translateX(-50%);
        z-index: -1;
        pointer-events: none;
        /*
           Arriba, una nube de luz blanca al centro (para que los textos de
           todas las secciones se lean); abajo, el bosque. A los costados
           la nube se desvanece y el bosque se sigue viendo.
        */
        background-image:
          radial-gradient(
            ellipse 56% 62% at 50% 50%,
            rgba(255, 253, 247, 0.95) 0%,
            rgba(255, 251, 242, 0.85) 50%,
            rgba(255, 250, 240, 0) 100%
          ),
          radial-gradient(
            ellipse 48% 30% at 50% 18%,
            rgba(255, 255, 255, 0.8) 0%,
            rgba(255, 255, 255, 0) 100%
          ),
          radial-gradient(
            ellipse 48% 30% at 50% 82%,
            rgba(255, 255, 255, 0.8) 0%,
            rgba(255, 255, 255, 0) 100%
          ),
          /* Franja vertical blanca de arriba a abajo; los costados quedan
             libres para que se vea el bosque */
          linear-gradient(
            90deg,
            rgba(255, 250, 240, 0) 6%,
            rgba(255, 250, 240, 0.55) 28%,
            rgba(255, 250, 240, 0.55) 72%,
            rgba(255, 250, 240, 0) 94%
          ),
          url("/imagenes/fondoprincipal.webp");
        background-size: 100% 100%, 100% 100%, 100% 100%, 100% 100%, cover;
        background-position: center;
        background-repeat: no-repeat;
      }
    </style>
  </head>
  <body class="min-h-screen m-0 p-0">
    <main class="m-0 p-0 overflow-x-hidden">
      <slot />
    </main>
  </body>
</html>
