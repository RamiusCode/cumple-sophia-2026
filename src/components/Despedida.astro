---
// src/components/Despedida.astro
// Cierre de la invitación: pedido de confirmar asistencia, "¡Te
// esperamos!" y la firma. Al pie, la franja de hojas con el conejito a la
// izquierda y la ardilla a la derecha, mirándose.
//
// Imágenes:
//   /imagenes/floresabajo.webp  franja de hojas del pie
//   /imagenes/conejo.webp       conejito a la izquierda (espejado, para
//                               que mire al centro)
//   /imagenes/ardilla.webp      ardilla a la derecha, mirando al centro
// Letras (en /fonts/, las mismas del resto):
//   dancing-script-600.woff2   títulos y firma

// ── DATOS EDITABLES ───────────────────────────────────────────
const tituloConfirmar = "Confirma tu asistencia";
const textoConfirmar =
    "Por favor, avísanos si vienes, así preparamos todo con mucho cariño para ti.";
const despedida = "¡Te esperamos!";
const firma = "Con cariño, Sophia";
const textoBoton = "Confirmar";
// WhatsApp de Bolivia: 591 + número, sin espacios ni el signo +
const whatsapp = "59175664006";
const cumpleanera = "Sophia";
const fechaTexto = "el lunes 16 de noviembre";
// ──────────────────────────────────────────────────────────────

// Mensaje que llega armado al WhatsApp (sin emojis)
const mensaje = `Hola, me complace confirmar mi asistencia al cumpleaños de ${cumpleanera}, ${fechaTexto}. Gracias por la invitación.`;
const enlaceWhatsapp = `https://wa.me/${whatsapp}?text=${encodeURIComponent(mensaje)}`;
---

<section id="despedida" class="seccion">
    <h2 class="titulo" data-entra="der">{tituloConfirmar}</h2>
    <p class="texto" data-entra="izq">{textoConfirmar}</p>

    <a class="boton" data-entra="pop" href={enlaceWhatsapp} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
                d="M12 2.6a9.3 9.3 0 0 0-8 14.1L2.7 21.4l4.8-1.3A9.3 9.3 0 1 0 12 2.6zm0 17a7.7 7.7 0 0 1-3.9-1.1l-.3-.2-2.8.8.8-2.8-.2-.3A7.7 7.7 0 1 1 12 19.6zm4.2-5.8c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1-.2-.1-1-.4-1.9-1.2-.7-.6-1.2-1.4-1.3-1.6-.1-.2 0-.4.1-.5l.4-.4.2-.4v-.4l-.7-1.7c-.2-.4-.4-.4-.5-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 1.9s.8 2.2.9 2.4c.1.2 1.6 2.5 3.9 3.4 2 .8 2.4.6 2.8.6.4 0 1.4-.6 1.6-1.1.2-.6.2-1 .1-1.1l-.4-.2z"
            ></path>
        </svg>
        <span>{textoBoton}</span>
    </a>

    <!-- Separador de puntitos de colores (como en Recepción) -->
    <div class="puntos" data-entra="zoom" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span>
    </div>

    <p class="te-esperamos" data-entra="pop">{despedida}</p>
    <p class="firma" data-entra="izq">{firma}</p>

    <!-- Pie: hojas, conejito y ardilla -->
    <div class="pie" aria-hidden="true">
        <img
            src="/imagenes/conejo.webp"
            alt=""
            width="265"
            height="420"
            class="animal conejo" data-entra="animal-izq"
            loading="lazy"
        />
        <img
            src="/imagenes/ardilla.webp"
            alt=""
            width="283"
            height="280"
            class="animal ardilla" data-entra="animal-der"
            loading="lazy"
        />
        <img
            src="/imagenes/floresabajo.webp"
            alt=""
            width="900"
            height="285"
            class="hojas" data-entra="abajo"
            loading="lazy"
        />
    </div>
</section>

<style>
    @font-face {
        font-family: "Dancing Script Sitio";
        src: url("/fonts/dancing-script-600.woff2") format("woff2");
        font-weight: 600;
        font-display: swap;
    }
    @font-face {
        font-family: "Cinzel";
        src: url("/fonts/cinzel-600.woff2") format("woff2");
        font-weight: 600;
        font-display: swap;
    }

    /* Sin fondo propio: se ve el fondo principal del layout */
    .seccion {
        position: relative;
        width: 100%;
        overflow: hidden;
        padding: 2rem 10% 0;
        box-sizing: border-box;
        text-align: center;
        color: #4a2c14;
    }

    /* ── Confirmar asistencia ───────────────────────────────── */
    .titulo {
        margin: 0 0 0.8rem;
        font-family: "Dancing Script Sitio", "Great Vibes", cursive;
        font-weight: 600;
        font-size: clamp(1.8rem, 8.6vw, 2.2rem);
        line-height: 1.15;
        color: #d23b55;
        -webkit-text-stroke: 0.14em #ffffff;
        paint-order: stroke fill;
        filter: drop-shadow(0 3px 4px rgba(150, 40, 60, 0.3));
    }
    .texto {
        margin: 0 auto;
        max-width: 22rem;
        font-family: "Cormorant Garamond", serif;
        font-weight: 700;
        font-size: clamp(1.1rem, 5.2vw, 1.3rem);
        line-height: 1.35;
        text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    /* Mismo botón que "Ver ubicación" en Recepción */
    .boton {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 1.2rem;
        padding: 0.75rem 1.6rem;
        border-radius: 999px;
        border: 3px solid #ffffff;
        background-image: linear-gradient(180deg, #e0414a, #b3101d);
        box-shadow:
            0 0 0 2.5px #d8303b,
            0 6px 12px rgba(120, 20, 20, 0.3);
        font-family: "Cinzel", serif;
        font-weight: 600;
        font-size: clamp(0.9rem, 4.2vw, 1.05rem);
        color: #ffffff;
        text-decoration: none;
        white-space: nowrap;
        transition: transform 0.2s ease;
    }
    .boton:active {
        transform: scale(0.95);
    }
    .boton svg {
        width: 1.35em;
        height: 1.35em;
        fill: #ffffff;
    }

    .puntos {
        display: flex;
        justify-content: center;
        gap: 0.55rem;
        margin: 1.4rem 0 1.2rem;
    }
    .puntos span {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-image: linear-gradient(#d8303b, #d8303b);
    }
    .puntos span:nth-child(3n + 2) {
        background-image: linear-gradient(#f4c534, #f4c534);
    }
    .puntos span:nth-child(3n + 3) {
        background-image: linear-gradient(#3d73c9, #3d73c9);
    }

    /* ── ¡Te esperamos! ─────────────────────────────────────── */
    .te-esperamos {
        margin: 0;
        font-family: "Dancing Script Sitio", "Great Vibes", cursive;
        font-weight: 600;
        font-size: clamp(2.8rem, 13.5vw, 3.6rem);
        line-height: 1.1;
        color: #c0161f;
        -webkit-text-stroke: 0.12em #ffffff;
        paint-order: stroke fill;
        filter: drop-shadow(0 4px 6px rgba(150, 30, 40, 0.3));
        animation: latir 2.6s ease-in-out infinite;
    }
    @keyframes latir {
        0%,
        100% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.04);
        }
    }
    .firma {
        margin: 0.4rem 0 0;
        font-family: "Dancing Script Sitio", "Great Vibes", cursive;
        font-weight: 600;
        font-size: clamp(1.3rem, 6vw, 1.55rem);
        color: #6b3a14;
        text-shadow: 0 1px 0 rgba(255, 255, 255, 0.8);
    }

    /* ── Pie con hojas y animalitos ─────────────────────────── */
    .pie {
        position: relative;
        width: 125%;
        margin: 0.6rem -12.5% 0;
        /* Alto de la franja de hojas (900x285) más lugar para los animales */
        aspect-ratio: 900 / 430;
    }
    .hojas {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 100%;
        height: auto;
        z-index: 2;
        pointer-events: none;
        user-select: none;
        -webkit-user-drag: none;
    }
    /* Los animalitos van detrás de las hojas de adelante, como asomados */
    .animal {
        position: absolute;
        z-index: 1;
        height: auto;
        pointer-events: none;
        user-select: none;
        -webkit-user-drag: none;
        filter: drop-shadow(0 5px 6px rgba(60, 40, 20, 0.25));
    }
    /* Más grandes y los dos mirando hacia el centro */
    .conejo {
        left: 18%;
        bottom: 12%;
        width: 24%;
        transform: scaleX(-1);
    }
    .ardilla {
        right: 16%;
        bottom: 12%;
        width: 27%;
    }

    @media (prefers-reduced-motion: reduce) {
        .te-esperamos {
            animation: none;
        }
    }
</style>
